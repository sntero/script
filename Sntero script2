			if hum then hum.PlatformStand = state end
			if state then
				bv = create("BodyVelocity", char.HumanoidRootPart, {Name = "FlyV", MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero})
				bg = create("BodyGyro", char.HumanoidRootPart, {Name = "FlyG", MaxTorque = Vector3.new(1e9, 1e9, 1e9), CFrame = char.HumanoidRootPart.CFrame})
			else

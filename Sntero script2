				for _, p in pairs(Players:GetPlayers()) do
					if p ~= player and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
						local hum = p.Character.Humanoid
						if hum.Health > 0 then
							local head = p.Character.Head
							local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
							if onScreen then
								local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
								local dist = (screenPos2D - screenCenter).Magnitude
								if dist <= fovRadiusVal and dist < shortestDistance then
									shortestDistance = dist
									closestPlayer = p
								end
							end
						end
					end
				end
				
				if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("Head") then
					local hum = closestPlayer.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then

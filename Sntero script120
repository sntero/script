local WEEK_SECONDS = 7 * 24 * 60 * 60 -- أسبوع كامل بالثواني

local function checkSavedKey()
	if writefile and readfile and isfile and isfile(KEY_FILE) then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile(KEY_FILE))
		end)
		if success and data and data.ExpireTime then
			if os.time() < data.ExpireTime then
				return true
			end
		end
	end
	return false
end

local function saveKeySession()
	if writefile then
		local data = { ExpireTime = os.time() + WEEK_SECONDS }
		pcall(function()
			writefile(KEY_FILE, HttpService:JSONEncode(data))
		end)
	end
end

